<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>ForgeConflict</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Publication portable. RuntimeIdentifier et SelfContained sont passes par
       build.ps1 : declares ici, ils insereraient un niveau win-x64 dans les
       chemins de build ordinaires et feraient diverger les arbres d'artefacts. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Le rognage casse WPF, qui repose massivement sur la reflexion. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeConflict.Core\ForgeConflict.Core.csproj" />
    <ProjectReference Include="..\ForgeConflict.Native\ForgeConflict.Native.csproj" />
  </ItemGroup>

</Project>
