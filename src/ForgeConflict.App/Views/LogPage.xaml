<Page x:Class="ForgeConflict.App.Views.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Journal">
    <Grid Margin="32,16,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Journal" Style="{StaticResource TitrePage}" Foreground="{DynamicResource TexteFort}" />
            <TextBlock x:Name="Chemin" Style="{StaticResource Legende}" Foreground="{DynamicResource TexteDoux}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button x:Name="Refresh" Content="Rafraichir" Click="OnRefresh" Padding="16,8" />
                <ui:Button x:Name="OpenFolder" Content="Ouvrir le dossier" Click="OnOpenFolder"
                           Padding="16,8" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource BordureTheme}"
                Background="{DynamicResource SurfaceRaised}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="16">
                <TextBlock x:Name="Contenu" Style="{StaticResource Donnee}" Foreground="{DynamicResource TexteFort}" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
