<ui:FluentWindow x:Class="ForgeConflict.App.Views.ConfirmChangesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Confirmer la correction"
                 Height="600" Width="720"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Confirmer la correction" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,8,28,20">
            <StackPanel>
                <TextBlock x:Name="Titre" FontSize="20" FontWeight="SemiBold"
                           FontFamily="{StaticResource TitreFont}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TexteFort}" />

                <TextBlock Text="Ce que fait cette correction" FontWeight="SemiBold" FontSize="12"
                           Margin="0,20,0,0" Foreground="{DynamicResource TexteDoux}" />
                <TextBlock x:Name="Explication" TextWrapping="Wrap" Margin="0,5,0,0"
                           Foreground="{DynamicResource TexteFort}" />

                <TextBlock Text="Modifications exactes" FontWeight="SemiBold" FontSize="12"
                           Margin="0,20,0,0" Foreground="{DynamicResource TexteDoux}" />

                <!-- Rien n'est resume ni arrondi : chaque valeur avant et apres est
                     montree telle qu'elle sera ecrite. -->
                <Border Margin="0,6,0,0" CornerRadius="6" BorderThickness="1" Padding="14,12"
                        BorderBrush="{DynamicResource BordureTheme}"
                        Background="{DynamicResource SurfaceRaised}">
                    <ItemsControl x:Name="Changements">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Donnee}"
                                               Foreground="{DynamicResource TexteDoux}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding ValueName}" Style="{StaticResource Donnee}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TexteFort}" />
                                        <TextBlock Text="{Binding Before}" Style="{StaticResource Donnee}"
                                                   Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TexteDoux}" />
                                        <TextBlock Text="→" Style="{StaticResource Donnee}" Margin="8,0"
                                                   Foreground="{DynamicResource TexteDoux}" />
                                        <TextBlock Text="{Binding After}" Style="{StaticResource Donnee}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Attention}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border x:Name="BandeauRisque" Margin="0,18,0,0" CornerRadius="6"
                        BorderThickness="1" Padding="14,12"
                        BorderBrush="{DynamicResource BordureTheme}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" x:Name="BarreRisque"
                                   Fill="{DynamicResource Attention}" />
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock x:Name="TitreRisque" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TexteFort}" />
                            <TextBlock x:Name="DetailRisque" TextWrapping="Wrap" FontSize="12"
                                       Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource TexteDoux}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="28,16"
                BorderBrush="{DynamicResource BordureTheme}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Annuler est le bouton par defaut : une fermeture accidentelle de la
                     fenetre ne doit jamais valoir accord. -->
                <ui:Button x:Name="Annuler" Content="Ne rien modifier" Padding="18,9"
                           IsCancel="True" Click="OnCancel" />
                <ui:Button x:Name="Appliquer" Content="Appliquer la correction" Appearance="Primary"
                           Padding="18,9" Margin="10,0,0,0" Click="OnApply" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
