<ui:FluentWindow x:Class="ForgeConflict.App.Views.WatchdogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Conserver ces modifications ?"
                 Height="330" Width="560"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 Topmost="True"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Conserver ces modifications ?"
                     ShowMaximize="False" ShowMinimize="False" ShowClose="False" />

        <StackPanel Grid.Row="1" Margin="28,8,28,0">
            <TextBlock Text="L'affichage fonctionne-t-il correctement ?"
                       FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                       FontFamily="{StaticResource TitreFont}"
                       Foreground="{DynamicResource TexteFort}" />

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TexteDoux}"
                       Text="La correction a ete appliquee. Si vous lisez ce message, l'affichage repond toujours. Sans reponse de votre part, les modifications seront annulees automatiquement." />

            <!-- Le compte a rebours est visible en permanence : l'utilisateur doit
                 savoir combien de temps il lui reste, pas le deviner. -->
            <Grid Margin="0,22,0,0">
                <ProgressBar x:Name="Barre" Height="6" Minimum="0" Maximum="100" Value="100"
                             Foreground="{DynamicResource Attention}" />
            </Grid>
            <TextBlock x:Name="Compte" Margin="0,10,0,0" FontSize="13"
                       Style="{StaticResource Donnee}"
                       Foreground="{DynamicResource TexteDoux}" />
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="28,16"
                BorderBrush="{DynamicResource BordureTheme}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="Annuler" Content="Annuler les modifications" Padding="18,9"
                           Click="OnRevert" />
                <ui:Button x:Name="Conserver" Content="Conserver" Appearance="Primary"
                           Padding="18,9" Margin="10,0,0,0" Click="OnKeep" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
