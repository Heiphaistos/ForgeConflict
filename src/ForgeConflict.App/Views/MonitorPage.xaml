<Page x:Class="ForgeConflict.App.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Surveillance">

    <Grid Margin="32,16,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Surveillance temps reel" Style="{StaticResource TitrePage}"
                       Foreground="{DynamicResource TexteFort}" />
            <TextBlock Style="{StaticResource Legende}" TextWrapping="Wrap" MaxWidth="760"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource TexteDoux}"
                       Text="Signale le lancement d'une superposition et les reinitialisations du pilote au moment ou elles se produisent. La surveillance observe et previent : elle ne modifie jamais rien d'elle-meme." />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button x:Name="Basculer" Content="Demarrer la surveillance"
                           Appearance="Primary" Padding="18,9" Click="OnToggle" />
                <ui:Button x:Name="Vider" Content="Effacer" Padding="18,9" Margin="10,0,0,0"
                           Click="OnClear" />
                <TextBlock x:Name="Etat" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"
                           Foreground="{DynamicResource TexteDoux}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BordureTheme}"
                Background="{DynamicResource SurfaceRaised}">
            <ScrollViewer x:Name="Defilement" VerticalScrollBarVisibility="Auto" Padding="16">
                <ItemsControl x:Name="Evenements">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{Binding Brush}" />
                                <TextBlock Text="{Binding Time}" Style="{StaticResource Donnee}"
                                           Margin="10,0,0,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TexteDoux}" />
                                <TextBlock Text="{Binding Message}" Margin="12,0,0,0" TextWrapping="Wrap"
                                           MaxWidth="620" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TexteFort}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
