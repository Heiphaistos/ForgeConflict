<ui:FluentWindow x:Class="ForgeConflict.App.Views.UpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Mise à jour disponible"
                 Height="460" Width="620"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Mise à jour disponible" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,8,28,12">
            <TextBlock x:Name="Titre" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TexteFort}" />
            <TextBlock Text="Nouveautés" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,0"
                       Foreground="{DynamicResource TexteDoux}" />
            <Border Margin="0,6,0,0" CornerRadius="6" BorderThickness="1" Padding="14,10" Height="170"
                    BorderBrush="{DynamicResource BordureTheme}" Background="{DynamicResource SurfaceRaised}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Notes" TextWrapping="Wrap" Foreground="{DynamicResource TexteFort}" />
                </ScrollViewer>
            </Border>
            <ProgressBar x:Name="Progression" Height="8" Margin="0,16,0,0" Minimum="0" Maximum="1"
                         Visibility="Collapsed" />
            <TextBlock x:Name="Etat" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TexteDoux}"
                       Text="L'application se fermera puis redémarrera toute seule. Les empreintes et la signature sont vérifiées avant tout remplacement." />
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="28,16"
                BorderBrush="{DynamicResource BordureTheme}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="Plus_tard" Content="Plus tard" Padding="18,9" IsCancel="True" Click="OnLater" />
                <ui:Button x:Name="Installer" Content="Installer et redémarrer" Appearance="Primary"
                           Padding="18,9" Margin="10,0,0,0" Click="OnInstall" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
